{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
