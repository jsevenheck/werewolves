{
  "name": "werewolves",
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "description": "Moderator-free Werewolf / Mafia party game MVP",
  "main": "dist/server/src/index.js",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "pnpm -C ui-vue dev",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm -C ui-vue build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json && pnpm -C ui-vue typecheck",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "nanoid": "^5.1.16",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "diff": "^8.0.3",
    "esbuild": ">=0.25.0"
  }
}
